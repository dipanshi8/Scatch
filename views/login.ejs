<%- include('./partials/header') %>

<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-50 to-indigo-100 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8">
        <!-- Flash Messages -->
        <div id="flash-container">
            <% if(error && error.length>0){ %>
                <div class="alert alert-error shadow-lg">
                    <div>
                        <i class="ri-error-warning-line"></i>
                        <span><%= error[0] %></span>
                    </div>
                </div>
            <% } %>

            <% if(success && success.length>0){ %>
                <div class="alert alert-success shadow-lg">
                    <div>
                        <i class="ri-checkbox-circle-line"></i>
                        <span><%= success[0] %></span>
                    </div>
                </div>
            <% } %>
        </div>

        <div class="card bg-base-100 shadow-2xl">
            <div class="card-body">
                <div class="text-center mb-6">
                    <h2 class="text-3xl font-bold text-primary">Welcome Back</h2>
                    <p class="text-base-content/70 mt-2">Login to your Scatch account</p>
                </div>

                <form action="/login" method="POST" class="space-y-4">
                    <div class="form-control">
                        <label class="label">
                            <span class="label-text">Email</span>
                        </label>
                        <input 
                            type="email" 
                            name="email" 
                            placeholder="Enter your email" 
                            class="input input-bordered w-full" 
                            required
                            autocomplete="email"
                        />
                    </div>

                    <div class="form-control">
                        <label class="label">
                            <span class="label-text">Password</span>
                        </label>
                        <div class="relative">
                            <input 
                                type="password" 
                                name="password" 
                                placeholder="Enter your password" 
                                class="input input-bordered w-full pr-10" 
                                required
                                autocomplete="current-password"
                            />
                            <button type="button" class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600" onclick="togglePassword(this)">
                                <i class="ri-eye-line"></i>
                            </button>
                        </div>
                    </div>

                    <div class="form-control mt-6">
                        <button type="submit" class="btn btn-primary w-full">
                            <i class="ri-login-box-line"></i>
                            Login
                        </button>
                    </div>
                </form>

                <div class="divider"></div>

                <div class="text-center">
                    <p class="text-sm text-base-content/70">
                        New user? 
                        <a href="/signup" class="link link-primary font-semibold">Signup</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// Auto-hide flash messages after 3 seconds
setTimeout(() => {
    const container = document.getElementById('flash-container');
    if (container) {
        container.style.transition = 'opacity 0.5s';
        container.style.opacity = '0';
        setTimeout(() => container.remove(), 500);
    }
}, 3000);

function togglePassword(button) {
    const input = button.parentElement.querySelector('input');
    const icon = button.querySelector('i');
    
    if (input.type === 'password') {
        input.type = 'text';
        icon.className = 'ri-eye-off-line';
    } else {
        input.type = 'password';
        icon.className = 'ri-eye-line';
    }
}
</script>

<%- include('./partials/footer') %>

